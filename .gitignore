# Dependencies & build output
node_modules/
node_modules
dist/
site-dist/
build/
*.tsbuildinfo
coverage/

# Vite / PWA
packages/pager/dev-dist/
.vite/

# Playwright (E2E runs outside PR CI)
e2e/playwright-report/
e2e/test-results/
e2e/.auth/
# The E2E launcher's Central: SQLite files and the runtime descriptor
e2e/.runtime/

# Local runtime state — the Central keeps ONE SQLite file + audit log
data/
*.sqlite
*.sqlite-journal
*.db
.bipeur/local/
dev-server/

# Env & secrets — never commit a token, a key or a VAPID pair
.env
.env.*
!.env.example
*.pem

# Python bytecode (CI scripts in .github/)
__pycache__/
*.py[cod]
.pytest_cache/

# Editors & OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# NOTE: `.kiro/` is intentionally NOT ignored — Kiroween requires the
# folder to be tracked at the root of the repository. The `contest-guard`
# workflow fails if any .gitignore line ever matches it.

# Machine-local Claude Code hook settings (absolute worktree path)
packages/opencode-gate/claude/settings.hook.json
