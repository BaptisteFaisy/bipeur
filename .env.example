# Beeper — environment of the Central. Copy to `.env` and adapt.
# Nothing here is required to run the demo: every value has a safe default.

# --- Central -------------------------------------------------------------
BIPEUR_HOST=127.0.0.1
BIPEUR_PORT=8787
BIPEUR_DB=./data/bipeur.sqlite
BIPEUR_RULES=./.bipeur/rules.yaml

# First station, created on boot. Leave empty to generate one and print it.
BIPEUR_BOOTSTRAP_TOKEN=

# Attention budget (BIP-F-09). Red pages and family 9 always bypass it.
BIPEUR_BUDGET_PER_HOUR=6

# Audit retention (BIP-N-04). 30 days by default, never less in production.
BIPEUR_RETENTION_DAYS=30

# --- Web Push (BIP-F-19), optional --------------------------------------
# Generate a VAPID pair with: pnpm --filter @bipeur/central exec node scripts/vapid.mjs
BIPEUR_VAPID_PUBLIC_KEY=
BIPEUR_VAPID_PRIVATE_KEY=
BIPEUR_VAPID_SUBJECT=mailto:you@example.com

# --- SNPP gateway (BIP-F-28), RFC 1861 ----------------------------------
# Loopback only: the protocol is plaintext by design (A.9).
BIPEUR_SNPP_HOST=127.0.0.1
BIPEUR_SNPP_PORT=4440
BIPEUR_SNPP_LOGIN=

# --- Demo mode (BIP-F-31) -------------------------------------------------
# Isolated per visitor, wiped after 24 h, no account, no data kept.
BIPEUR_DEMO=0

# --- LLM (always optional, never on by default, section 0.4) -------------
# Used only to suggest a shorter subject line. No secret and no personal
# data is ever sent. Every feature has a model-free path.
BIPEUR_LLM_ENABLED=0
BIPEUR_LLM_PROVIDER=anthropic
BIPEUR_LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
